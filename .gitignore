# Local Terraform working directories (provider binaries, cached modules) -
# fully regenerated by `terraform init`, never needed in version control.
**/.terraform/

# State files - can contain sensitive data, and state that matters should
# live in the remote GCS backend (see bootstrap/), not in git.
*.tfstate
*.tfstate.*

# Real variable values (project IDs, IPs, etc.) - kept local only.
# See the committed *.tfvars.example files for the variables each
# environment needs and what shape the values should take.
*.tfvars

# Crash logs Terraform writes on an internal error.
crash.log
crash.*.log

# Session working notes for AI-assisted debugging - useful locally to
# resume work, not meant to be public.
CLAUDE.md

# Note: .terraform.lock.hcl is intentionally NOT ignored - it should be
# committed so everyone gets the exact same provider version.
