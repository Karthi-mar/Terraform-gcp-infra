project_id       = "your-gcp-project-id"
region           = "us-central1"
zone             = "us-central1-a"
env              = "dev"
ssh_source_range = ["YOUR_PUBLIC_IP/32"]

# Copy this file to terraform.tfvars (which is gitignored) and fill in
# your real values. bucket name in backend.tf must match the bucket
# created by bootstrap/. Find your public IPv4 with: curl -4 ifconfig.me
